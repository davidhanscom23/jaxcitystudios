NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayPal (sandbox or live)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# Optional display handles
NEXT_PUBLIC_VENMO_HANDLE=
NEXT_PUBLIC_ZELLE_DESTINATION=jaxcitystudios@gmail.com
NEXT_PUBLIC_ZELLE_NAME=JaxCity Studios

# SQLite calendar (optional). On Vercel this defaults to /tmp/jaxcity-studios/jaxcity.db
# because the app filesystem is read-only. Locally defaults to ./data/jaxcity.db
DATABASE_PATH=
